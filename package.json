{
  "name": "ai-price-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:stability": "tsx scripts/verify-collection-stability.ts",
    "collect": "tsx scripts/collect-prices.ts",
    "sync:data": "tsx scripts/sync-data.ts",
    "seed": "tsx scripts/seed.ts",
    "local:db:up": "docker compose -f compose.local.yml up -d --wait",
    "local:db:down": "docker compose -f compose.local.yml down",
    "local:setup": "npm run local:db:up && npm run db:migrate && npm run seed && npm run collect",
    "dev:local": "next dev --webpack -p 3100",
    "start:local": "next start -p 3100",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "next": "16.2.11",
    "nodemailer": "^9.0.3",
    "postcss": "^8.5.22",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "es-abstract": "^1.24.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.11",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "react-server-dom-webpack": "19.2.8",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
